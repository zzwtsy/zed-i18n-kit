{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zed-i18n-kit.invalid/schemas/review-bundle-v1.schema.json",
  "title": "zed-i18n-kit blind review bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_set_id",
    "zed_commit",
    "corpus_sample_sha256",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "zed_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "corpus_sample_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "path",
          "source_span",
          "anchor",
          "context_span",
          "source_context",
          "scope",
          "subject_kind",
          "sink_symbol",
          "text_slot",
          "sink_kind"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "pattern": "^zed-[0-9a-f]{7}-[0-9]{4}$"
          },
          "path": { "$ref": "#/$defs/sourcePath" },
          "source_span": { "$ref": "#/$defs/sourceSpan" },
          "anchor": { "type": "string", "minLength": 1 },
          "context_span": { "$ref": "#/$defs/sourceSpan" },
          "source_context": { "type": "string", "minLength": 1 },
          "scope": {
            "enum": ["production", "test", "example", "component_preview"]
          },
          "subject_kind": {
            "enum": ["sink_slot", "expression_origin", "scope_exclusion"]
          },
          "sink_symbol": { "type": ["string", "null"], "minLength": 1 },
          "text_slot": { "type": ["string", "null"], "minLength": 1 },
          "sink_kind": {
            "enum": [
              "visible_text",
              "tooltip",
              "accessibility",
              "toast",
              "prompt",
              "none",
              "unknown"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "pattern": "^crates/(?:(?!\\.{1,2}(?:/|$))[^/]+/)*(?!\\.{1,2}(?:/|$))[^/]+\\.rs$"
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte"],
      "properties": {
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
